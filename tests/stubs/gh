#!/usr/bin/env bash
# Stub `gh` for tests. Handles only the calls the kit makes; anything else fails loudly.
set -u
dir="${STUB_DIR:?STUB_DIR not set}"
echo "$*" >>"$dir/gh.log"
case "${1:-} ${2:-}" in
  "auth status") exit "${STUB_GH_AUTH:-0}" ;;
  "api user") echo "${STUB_GH_USER:-ana}"; exit 0 ;;
  "repo view")
    if [[ -n "${STUB_GH_NOT_FORK:-}" ]]; then echo ""; else echo "${STUB_GH_UPSTREAM:-workshop/leaderboard-api}"; fi
    exit 0 ;;
  "issue view")
    case "$*" in
      *"--json state"*) echo "${STUB_ISSUE_STATE:-OPEN}" ;;
      *"--json title"*) printf '%s\n' "${STUB_ISSUE_TITLE:-Add stats}" ;;
      *) printf 'title:\t%s\nstate:\tOPEN\n--\nstub issue body\n' "${STUB_ISSUE_TITLE:-Add stats}" ;;
    esac
    exit 0 ;;
  "pr create")
    if [[ -n "${STUB_GH_PR_FAIL:-}" ]]; then echo "stub gh: pr create failed" >&2; exit 1; fi
    n=$(($(cat "$dir/prcount" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$dir/prcount"
    printf '%s\0' "$@" >"$dir/pr.$n"
    prev=""
    for a in "$@"; do
      [[ "$prev" == "--body-file" ]] && cp "$a" "$dir/pr.$n.body"
      prev="$a"
    done
    echo "https://github.com/${STUB_GH_UPSTREAM:-workshop/leaderboard-api}/pull/$n"
    exit 0 ;;
esac
echo "stub gh: unhandled $*" >&2
exit 1
